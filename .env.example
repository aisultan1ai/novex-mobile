# Скопируйте в .env.local и подставьте свои значения. .env.local не коммитится.
# Для staging / production эти переменные задаются в EAS (окружения preview / production).

# Адрес API вместе с /api/v1. Для телефона в той же Wi-Fi сети — локальный IP компьютера, не localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Пока на бэкенде нет /mobile/auth/*: true — вход через мок поверх сайтового /auth/login
# (данные настоящие, но токен не обновляется — через ~60 минут снова экран входа). Только development.
EXPO_PUBLIC_MOCK_MOBILE_AUTH=true

# Адрес сайта Novex — для ссылки «Поделиться отслеживанием». Пусто — делимся только трек-номером.
EXPO_PUBLIC_WEB_URL=

# Необязательно: DSN проекта Sentry. Пусто — Sentry выключен.
EXPO_PUBLIC_SENTRY_DSN=
